# Copy to .env and set the current VM address.
# The lab VM address changes between sessions; this is the only file to update.
FINSERVE_URL=http://VM-IP-HERE:8082
ORDERENTRY_URL=http://VM-IP-HERE:8081
API_URL=http://VM-IP-HERE:8082/api
API_KEY=your-api-key
TEST_PASSWORD=your-password
OE_AGENT_EMAIL=your-agent-email
OE_AGENT_PASSWORD=your-agent-password
